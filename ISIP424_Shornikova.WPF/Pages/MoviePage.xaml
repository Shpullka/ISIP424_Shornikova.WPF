<Page x:Class="ISIP424_Shornikova.WPF.Pages.MoviePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP424_Shornikova.WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="MoviePage">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Image x:Name="PosterImg" Height="400" Stretch="Uniform" Source="{Binding CurrentMovie.PosterPath}" />
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="DescText" TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock x:Name="RatingText" Margin="0,10,0,0" FontWeight="Bold" />
                <TextBlock x:Name="AgeText" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Text="Сеансы:" FontSize="18" FontWeight="Bold" />
                <ListBox x:Name="SessionsList" Height="400" Margin="0,10,0,0"
                         MouseDoubleClick="SessionsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Text="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150" />
                                <TextBlock Text="{Binding Hall.Name, StringFormat='Зал: {0}'}" Width="120" />
                                <TextBlock Text="{Binding Hall.HallRating, StringFormat='({0})'}" Width="100" />
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0} руб.'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            <Button Content="Назад" Click="BackBtn_Click" Width="100" HorizontalAlignment="Left" Height="30" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
</Page>
