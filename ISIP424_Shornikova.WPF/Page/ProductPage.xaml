<Page x:Class="ISIP424_Shornikova.WPF.Page.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP424_Shornikova.WPF.Page"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,15" BorderBrush="AliceBlue" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Каталог товаров" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <Button Grid.Column="2" Content="Перейти в корзину" Click="GoToCart_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="5" Padding="10" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Категории" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
                    <ListBox x:Name="CategoriesListBox" SelectionChanged="CategoriesListBox_SelectionChanged" BorderThickness="0">
                        <ListBoxItem Content="Все товары" Tag="All" IsSelected="True"/>
                        <ListBoxItem Content="Электроника" Tag="Electronics" />
                        <ListBoxItem Content="Аксессуары" Tag="Accessories" />
                    </ListBox>
                </StackPanel>
            </Border>

            <ListBox x:Name="ProductsListView" Grid.Column="1" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="180">
                            <Image Source="{Binding ImagePath}" Height="150" Stretch="Uniform" />
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,10,0,5" TextWrapping="Wrap" Height="40" />
                            <TextBlock Text="{Binding Price}" Foreground="DarkGreen" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                            <Button Content="В корзину" Tag="{Binding}" Click="AddToCart_Click" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
