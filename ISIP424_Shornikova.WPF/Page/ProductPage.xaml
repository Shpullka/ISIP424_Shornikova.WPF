<Page x:Class="ISIP424_Shornikova.WPF.Page.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP424_Shornikova.WPF.Page"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
            <TextBlock Text="Каталог товаров" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Перейти в корзину" Click="GoToCart_Click" Margin="20,0,0,0" Padding="15,5" Background="LightGray" />
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="ProductsList">
                
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
